          {
            "label": "Solution x",
            "x": 4,
            "y": 11,
            "description": "(4, 11)"
          },
          {
            "label": "Y-Intercept",
            "x": 0,
            "y": 3,
            "description": "(0, 3)"
          }
        ]
      },
      "isVerified": true
