    "question": "2x + 3 = 11",
    "recognizedQuestion": "Solve for $x$: $2x +3 = 11$",
    "subject": "Algebra",
    "topic": "Linear Equations in One Variable",
    "finalAnswer": "$$x = 4$$",
    "timestamp": "2026-10-27T16:58:31.544Z",
    "solution": {
      "id": "sol-1793120311544",
      "subject": "Algebra",
      "topic": "Linear Equations in One Variable",
      "difficulty": "Basic",
      "recognizedQuestion": "Solve for $x$: $2x +3 = 11$",
      "givenInfo": [
        "Equation: $2x +3 = 11$",
        "Target variable: $x$"
      ],
      "conceptFormula": "To solve $ax + b = c$:\n1. Subtract $b$ from both sides: $ax = c - b$\n2. Divide by $a$: $x = \\frac{c - b}{a}$",
      "steps": [
        {
          "stepNumber": 1,
          "title": "Subtract 3 from both sides",
          "calculation": "$$2x = 11 - (3) = 8$$",
          "explanation": "Isolate the variable term by applying inverse operations to constants."
        },
        {
          "stepNumber": 2,
          "title": "Divide both sides by 2",
          "calculation": "$$x = \\frac{8}{2} = 4$$",
          "explanation": "Divide by the coefficient of $x$ to find the solution."
        }
      ],
      "finalAnswer": "$$x = 4$$",
      "verification": "Substitute $x = 4$ into original LHS:\n$$LHS = 2(4) + 3 = 11 = RHS$$\nVerified and correct!",
      "learningTip": "Always perform identical arithmetic operations on both sides of the equals sign.",
      "methods": [
        {
          "name": "Standard Algebraic Balancing",
          "description": "Isolate x step-by-step"
        },
        {
          "name": "Transposition",
          "description": "Move terms across equals sign"
        }
      ],
      "graphData": {
        "hasGraph": true,
        "type": "function",
        "expression": "2*x + 3",
        "domain": [
          -1,
          9
        ],
